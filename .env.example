DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-subdomain.ngrok-free.app

# Email notifications for new orders (example: Gmail or another SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=T&A Corner <your-email@gmail.com>
ORDER_NOTIFICATION_EMAIL=your-email@gmail.com

# Nova Poshta autocomplete for checkout
NOVA_POSHTA_API_KEY=your-nova-poshta-api-key
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_VERIFY_SSL=True

# LiqPay online payments
LIQPAY_PUBLIC_KEY=your-liqpay-public-key
LIQPAY_PRIVATE_KEY=your-liqpay-private-key
LIQPAY_CHECKOUT_URL=https://www.liqpay.ua/api/3/checkout
LIQPAY_CURRENCY=UAH
